# ========================
# Unity .gitignore
# ========================

# Carpetas generadas por Unity (se regeneran al abrir el proyecto)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/

# MemoryCaptures
/[Mm]emoryCaptures/

# Recordings
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated Crash Reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# ========================
# IDE / Editor
# ========================
.vs/
.vscode/
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ========================
# OS
# ========================
.DS_Store
Thumbs.db
desktop.ini


Assets/Editor/Migration/*.tgz
Assets/SamplesResources/AugmentationAssets/Models/*.FBX


Packages/com.ptc.vuforia.engine-*.tgz

